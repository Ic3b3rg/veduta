  "narrative": {
    "northStar": "Precision Tool",
    "overview": "The website carries Veduta's established dark tool identity into a readable visitor-facing page. Opaque surfaces, restrained violet actions and direct Inter typography keep attention on the actual interface. The guided tour uses production presentation, with a small frame for guidance.\n\nThis reference covers `packages/website`. [The visual language](../../docs/VISUAL-LANGUAGE.md) and [catalog tokens](../catalog/src/design-system.ts) own shared PWA and Atom styling; [landing CSS](src/landing.css) and [tour CSS](src/demo.css) supply the implemented website conventions. [PRODUCT.md](PRODUCT.md) owns surface scope. Product and demonstration truth remain in the [README](../../README.md), [glossary](../../GLOSSARY.md), [ADR-0036](../../docs/adr/0036-static-public-product-tour.md) and [demo guide](../../docs/DEMO.md).",
    "keyCharacteristics": [
      "Dark, opaque material separated by fine borders.",
      "Generous marketing typography beside the actual product.",
      "Restrained controls and shared production rendering in the tour."
    ],
    "rules": [],
    "dos": [
      "Do use the catalog's dark identity and the implemented website CSS as visual authority.",
      "Do keep product imagery clear, proportional and accompanied by readable captions.",
      "Do preserve the mobile guide-first order, wrapping and visible keyboard focus."
    ],
    "donts": [
      "Don't replace shared tour components with independent visual replicas.",
      "Don't introduce decorative gradients, glow, glass or ambient animation into this identity.",
      "Don't apply the landing's marketing type and spacing scale to production Atom controls."
    ]
  }
}
