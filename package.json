{
  "name": "veduta-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @veduta/daemon --filter @veduta/pwa run dev",
    "demo": "pnpm --filter @veduta/website dev",
    "demo:build": "pnpm --filter @veduta/website build",
    "demo:check": "pnpm demo:build && pnpm --filter @veduta/e2e exec playwright test --config demo/playwright.config.ts",
    "demo:record": "pnpm --filter @veduta/pwa build && pnpm --filter @veduta/e2e demo:record",
    "local-vps": "deploy/local-vps.sh",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
